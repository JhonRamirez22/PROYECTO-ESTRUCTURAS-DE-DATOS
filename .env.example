# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rutas_pasto?schema=public"
# En AWS RDS, deja DATABASE_URL sin definir y usa estas variables separadas;
# usuario/contraseña se inyectan desde Secrets Manager y TLS verifica el host.
DATABASE_HOST=""
DATABASE_PORT="5432"
DATABASE_NAME="rutas_pasto"
DATABASE_USERNAME=""
DATABASE_PASSWORD=""
DATABASE_SSL_MODE="verify-full"
DATABASE_SSL_ROOT_CERT="/etc/ssl/certs/rds-global-bundle.pem"
# Solo las tareas puntuales de aprovisionamiento/migración usan credenciales admin.
DATABASE_ADMIN_USERNAME=""
DATABASE_ADMIN_PASSWORD=""
# El backend asume producción si falta NODE_ENV; pnpm dev lo fija a development.
NODE_ENV="production"

# FastAPI. En local, Next reenvía /api/* a este origen. En Vercel, define
# PYTHON_API_URL con la URL HTTPS de ECS Express Mode; Next hace proxy server-side.
# AUTH_SECRET, DISPATCHER_ACCESS_CODE y claves de integración son solo del backend:
# guárdalos en Secrets Manager en AWS, nunca como variables del frontend Vercel.
PYTHON_API_URL="http://127.0.0.1:8000"

# Acceso privado del personal. Generate both values with a cryptographically
# secure random generator; never reuse a public API key as either credential.
AUTH_SECRET="generate-a-unique-random-secret-of-at-least-32-bytes"
DISPATCHER_ACCESS_CODE="generate-a-unique-random-access-code-of-at-least-32-characters"

# OSRM primario. Puede apuntar a un servidor self-hosted; por defecto el
# cliente usa https://router.project-osrm.org.
# Cambia a "ors" solo cuando ORS_API_KEY esté configurada.
ROUTING_PROVIDER="osrm"
OSRM_API_URL="https://router.project-osrm.org"

# OpenRouteService alternativo (no necesario para el flujo primario de OSRM).
ORS_API_KEY=""
ORS_API_URL="https://api.openrouteservice.org"

# TomTom Traffic Flow; solo backend. La clave real va en .env, nunca en el bundle web.
TOMTOM_API_KEY=""
TOMTOM_TRAFFIC_TIMEOUT_MS="3500"

# IA externa opcional. Para NVIDIA NIM/OpenAI-compatible se usa la URL completa
# terminada en /v1/chat/completions; el cliente detecta ese protocolo.
AI_TRAFFIC_API_URL=""
AI_TRAFFIC_API_KEY=""
AI_TRAFFIC_MODEL=""
AI_TRAFFIC_TIMEOUT_MS="5000"
# Opt-in explícito: el proveedor externo recibirá coordenadas de rutas y,
# al normalizar pedidos, dirección y coordenadas de entrega. Default seguro.
AI_ALLOW_LOCATION_DATA_SHARING="false"

# Asistente de preguntas del cliente. Compatible con APIs OpenAI Chat Completions.
# El texto libre no se envía: se comparte el estado básico y hasta 8 intenciones
# canónicas del pedido. Guía, dirección, coordenadas, nombre, teléfono e IDs se excluyen.
# Groq GPT-OSS 20B ofrece alta velocidad para respuestas breves; puedes cambiar el modelo.
# Catálogo oficial: https://console.groq.com/docs/models
CUSTOMER_CHAT_API_URL="https://api.groq.com/openai/v1/chat/completions"
CUSTOMER_CHAT_API_KEY=""
CUSTOMER_CHAT_MODEL="openai/gpt-oss-20b"
CUSTOMER_CHAT_TIMEOUT_MS="5000"

# Avisos opcionales al cliente. Solo se envían si el cliente dio consentimiento
# explícito al registrar el pedido. Puerto 587 usa STARTTLS; 465 usa TLS implícito.
NOTIFICATION_SMTP_HOST=""
NOTIFICATION_SMTP_PORT="587"
NOTIFICATION_SMTP_USERNAME=""
NOTIFICATION_SMTP_PASSWORD=""
NOTIFICATION_FROM_EMAIL=""
NOTIFICATION_SMTP_TIMEOUT_MS="5000"
# FastAPI ignora este worker si VERCEL=1; habilítalo solo en un proceso persistente.
CUSTOMER_NOTIFICATION_WORKER_ENABLED="false"
CUSTOMER_NOTIFICATION_POLL_SECONDS="30"
# SMS opcional vía Twilio REST. Solo se usa con consentimiento explícito del cliente.
NOTIFICATION_SMS_TWILIO_ACCOUNT_SID=""
NOTIFICATION_SMS_TWILIO_AUTH_TOKEN=""
NOTIFICATION_SMS_TWILIO_FROM_PHONE=""
NOTIFICATION_SMS_TIMEOUT_MS="5000"

# Mapa - Coordenadas por defecto: Pasto, Nariño
NEXT_PUBLIC_MAP_DEFAULT_LAT=1.2136
NEXT_PUBLIC_MAP_DEFAULT_LNG=-77.2811
# Opcional: URL de un style JSON de MapLibre. Si queda vacío se usa el estilo
# oscuro de OpenFreeMap; si falla, el componente usa un fallback OSM local.
NEXT_PUBLIC_MAP_STYLE_URL=""
